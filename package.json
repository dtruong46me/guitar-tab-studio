{
  "name": "guitar-tab-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based guitar tablature editor with vector PDF export",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "idb": "8.0.3",
    "immer": "10.1.1",
    "jspdf": "3.0.1",
    "pdfjs-dist": "6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@types/node": "22.15.21",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
